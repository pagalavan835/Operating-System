#include <stdio.h>
#include <sys/types.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <unistd.h>
#define SIZE 10
struct CircularBuffer {
    int data[SIZE];
    int write_index;
    int read_index;
    int item_count;
};
int main() {
    int shmid;
    struct CircularBuffer *buf;
    int num;
    shmid = shmget(55555, sizeof(struct CircularBuffer), 0666);
    if (shmid == -1) {
        perror("shmget");
        return 1;
    }
    buf = (struct CircularBuffer*)shmat(shmid, NULL, 0);
    if (buf == (void*)-1) {
        perror("shmat");
        return 1;
    }
    printf("Reading data from shared memory:\n");
    while (buf->item_count > 0) {
        num = buf->data[buf->read_index];
        printf("Consumed: %d\n", num);
        buf->read_index = (buf->read_index + 1) % SIZE;
        buf->item_count--;
    }
    shmctl(shmid, IPC_RMID, NULL);
    shmdt(buf);
    return 0;
}

