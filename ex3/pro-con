#include <stdio.h>
#include <sys/types.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <unistd.h>
#define SIZE 10
struct CircularBuffer {
    int data[SIZE];
    int write_index;
    int read_index;
    int item_count;
};
int main() {
    int shmid;
    struct CircularBuffer *buf;
    int i, num;
    shmid = shmget(55555, sizeof(struct CircularBuffer), IPC_CREAT | 0666);
    if (shmid == -1) {
        perror("shmget");
        return 1;
    }
    buf = (struct CircularBuffer*)shmat(shmid, NULL, 0);
    if (buf == (void*)-1) {
        perror("shmat");
        return 1;
    }
    buf->write_index = 0;
    buf->read_index = 0;
    buf->item_count = 0;
    for (i = 0; i < SIZE; i++) {
        printf("Enter data: ");
        if (scanf("%d", &num) != 1) break; 
        buf->data[buf->write_index] = num;
        buf->write_index = (buf->write_index + 1) % SIZE;
        buf->item_count++;
    }
    shmdt(buf);
    return 0;
}

