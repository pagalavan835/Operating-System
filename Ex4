#include <stdio.h>

struct Process
{
    int pid;
    int bt;
    int wt;
    int tat;
    int priority;
};

/* FCFS */
void fcfs(struct Process p[], int n)
{
    int i;
    float avgwt = 0, avgtat = 0;

    p[0].wt = 0;

    for(i = 1; i < n; i++)
        p[i].wt = p[i-1].wt + p[i-1].bt;

    printf("\n\nFCFS Scheduling");
    printf("\nPID\tBT\tWT\tTAT\n");

    for(i = 0; i < n; i++)
    {
        p[i].tat = p[i].wt + p[i].bt;

        avgwt += p[i].wt;
        avgtat += p[i].tat;

        printf("%d\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].bt,
               p[i].wt,
               p[i].tat);
    }

    printf("Average Waiting Time = %.2f\n", avgwt/n);
    printf("Average Turnaround Time = %.2f\n", avgtat/n);
}

/* SJF */
void sjf(struct Process p[], int n)
{
    int i, j;
    struct Process temp;
    float avgwt = 0, avgtat = 0;

    for(i = 0; i < n-1; i++)
    {
        for(j = i+1; j < n; j++)
        {
            if(p[i].bt > p[j].bt)
            {
                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    p[0].wt = 0;

    for(i = 1; i < n; i++)
        p[i].wt = p[i-1].wt + p[i-1].bt;

    printf("\n\nSJF Scheduling");
    printf("\nPID\tBT\tWT\tTAT\n");

    for(i = 0; i < n; i++)
    {
        p[i].tat = p[i].wt + p[i].bt;

        avgwt += p[i].wt;
        avgtat += p[i].tat;

        printf("%d\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].bt,
               p[i].wt,
               p[i].tat);
    }

    printf("Average Waiting Time = %.2f\n", avgwt/n);
    printf("Average Turnaround Time = %.2f\n", avgtat/n);
}

/* Priority Scheduling */
void priorityScheduling(struct Process p[], int n)
{
    int i, j;
    struct Process temp;
    float avgwt = 0, avgtat = 0;

    for(i = 0; i < n-1; i++)
    {
        for(j = i+1; j < n; j++)
        {
            if(p[i].priority > p[j].priority)
            {
                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }

    p[0].wt = 0;

    for(i = 1; i < n; i++)
        p[i].wt = p[i-1].wt + p[i-1].bt;

    printf("\n\nPriority Scheduling");
    printf("\nPID\tBT\tPriority\tWT\tTAT\n");

    for(i = 0; i < n; i++)
    {
        p[i].tat = p[i].wt + p[i].bt;

        avgwt += p[i].wt;
        avgtat += p[i].tat;

        printf("%d\t%d\t%d\t\t%d\t%d\n",
               p[i].pid,
               p[i].bt,
               p[i].priority,
               p[i].wt,
               p[i].tat);
    }

    printf("Average Waiting Time = %.2f\n", avgwt/n);
    printf("Average Turnaround Time = %.2f\n", avgtat/n);
}

/* Round Robin */
void roundRobin(struct Process p[], int n, int tq)
{
    int rem_bt[20];
    int i, time = 0, done;
    float avgwt = 0, avgtat = 0;

    for(i = 0; i < n; i++)
        rem_bt[i] = p[i].bt;

    do
    {
        done = 1;

        for(i = 0; i < n; i++)
        {
            if(rem_bt[i] > 0)
            {
                done = 0;

                if(rem_bt[i] > tq)
                {
                    time += tq;
                    rem_bt[i] -= tq;
                }
                else
                {
                    time += rem_bt[i];
                    p[i].tat = time;
                    p[i].wt = p[i].tat - p[i].bt;
                    rem_bt[i] = 0;
                }
            }
        }
    } while(done == 0);

    printf("\n\nRound Robin Scheduling");
    printf("\nPID\tBT\tWT\tTAT\n");

    for(i = 0; i < n; i++)
    {
        avgwt += p[i].wt;
        avgtat += p[i].tat;

        printf("%d\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].bt,
               p[i].wt,
               p[i].tat);
    }

    printf("Average Waiting Time = %.2f\n", avgwt/n);
    printf("Average Turnaround Time = %.2f\n", avgtat/n);
}
int main()
{
    int n, i, tq;
    struct Process p[20], p1[20], p2[20], p3[20];

    printf("Enter the Number of Processes: ");
    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        p[i].pid = i + 1;

        printf("\nProcess %d\n", i + 1);

        printf("Enter Burst Time: ");
        scanf("%d", &p[i].bt);

        printf("Enter Priority: ");
        scanf("%d", &p[i].priority);

        p1[i] = p[i];
        p2[i] = p[i];
        p3[i] = p[i];
    }

    printf("\nEnter Time Quantum for Round Robin: ");
    scanf("%d", &tq);

    printf("\n----------------------------------");
    fcfs(p, n);

    printf("\n----------------------------------");
    sjf(p1, n);

    printf("\n----------------------------------");
    priorityScheduling(p2, n);

    printf("\n----------------------------------");
    roundRobin(p3, n, tq);

    return 0;
}
