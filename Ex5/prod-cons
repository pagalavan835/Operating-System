#include <fcntl.h>
#include <sys/mman.h>
#include <sys/stat.h>
#include <semaphore.h>
#include <unistd.h>

#define BUFFER_SIZE 5

// Updated uniquely with _v2 suffix to prevent 'Permission Denied' conflicts
#define SHM_NAME "/shm_24bcs049_v2"
#define SEM_MUTEX "/sem_mutex_24bcs054_v2"
#define SEM_EMPTY "/sem_empty_24bcs054_v2"
#define SEM_FULL "/sem_full_24bcs054_v2"

typedef struct {
    int buffer[BUFFER_SIZE];
    int in;
    int out;
} shared_data_t;

