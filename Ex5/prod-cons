#include "common.h"

int main() {
    // Clean up any stale instances from previous crashed runs
    shm_unlink(SHM_NAME);
    sem_unlink(SEM_MUTEX);
    sem_unlink(SEM_EMPTY);
    sem_unlink(SEM_FULL);

    // 1. Create and map shared memory
    int shm_fd = shm_open(SHM_NAME, O_CREAT | O_RDWR, 0666);
    if (shm_fd == -1) {
        perror("shm_open failed");
        exit(1);
    }
    ftruncate(shm_fd, sizeof(shared_data_t));
    shared_data_t *shared = (shared_data_t *)mmap(NULL, sizeof(shared_data_t), PROT_READ | PROT_WRITE, MAP_SHARED, shm_fd, 0);

    // Reset circular buffer trackers
    shared->in = 0;
    shared->out = 0;

    // 2. Initialize Semaphores
    sem_t *mutex = sem_open(SEM_MUTEX, O_CREAT, 0666, 1);
    sem_t *empty = sem_open(SEM_EMPTY, O_CREAT, 0666, BUFFER_SIZE);
    sem_t *full = sem_open(SEM_FULL, O_CREAT, 0666, 0);

    printf("Producer started. (Enter -1 to exit)\n\n");

    int input_item;
    while (1) {
        printf("Enter an integer to produce: ");
        if (scanf("%d", &input_item) != 1) {
            printf("Invalid input. Please enter numbers only.\n");
            while (getchar() != '\n'); // Clear tracking line
            continue;
        }

        // Check for termination signal
        if (input_item == -1) {
            int empty_slots;
            sem_getvalue(empty, &empty_slots);

            // If buffer is entirely full, exit immediately instead of hanging
            if (empty_slots == 0) {
                printf("\nBuffer is full! Exiting producer directly without dropping -1.\n");
                break;
            }

            // Otherwise, drop the exit code into an available slot
            sem_wait(empty);
            sem_wait(mutex);
            shared->buffer[shared->in] = -1;
            shared->in = (shared->in + 1) % BUFFER_SIZE;
            sem_post(mutex);
            sem_post(full);
            break;
        }

        printf("[Waiting] Checking if buffer has empty space...\n");
        sem_wait(empty); // Will block here if empty_slots == 0
        sem_wait(mutex); 

        // Insert item into shared circular buffer
        shared->buffer[shared->in] = input_item; 
        printf(">> [Success] Produced: %d at index %d\n\n", shared->buffer[shared->in], shared->in);
        shared->in = (shared->in + 1) % BUFFER_SIZE;

        sem_post(mutex); 
        sem_post(full);  
    }

    // Free local process memory allocations
    munmap(shared, sizeof(shared_data_t));
    close(shm_fd);
    sem_close(mutex);
    sem_close(empty);
    sem_close(full);

    printf("Producer terminated successfully.\n");
    return 0;
}

