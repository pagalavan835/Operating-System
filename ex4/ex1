                printf("Enter Priority: ");
                scanf("%d", &p[i].priority);
            }
            data_entered = 1;
            continue;
        }

        // Check if data exists before running simulation loops
        if(!data_entered)
        {
            printf("\n[Error]: Please enter process data first (Option 1)!\n");
            continue;
        }for(i = 0; i < n; i++) {
            temp_p[i] = p[i];
        }

        switch(choice) {
            case 2:
                fcfs(temp_p, n);
                break;
            case 3:
                sjfNonPreemptive(temp_p, n);
                break;
            case 4:
                sjfPreemptive(temp_p, n);
                break;
            case 5:
                priorityNonPreemptive(temp_p, n);
                break;
            case 6:
                priorityPreemptive(temp_p, n);
                break;
            case 7:
                printf("Enter Time Quantum: ");
                scanf("%d", &tq);
                roundRobin(temp_p, n, tq);
                break;
            default:
                printf("\n[Error]: Invalid choice! Please select between 1 and 8.\n");
        }
    }
    return 0;
}
